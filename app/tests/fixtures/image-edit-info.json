            "dpmpp_2m_sde_heun",
            "dpmpp_2m_sde_heun_gpu",
            "dpmpp_3m_sde",
            "dpmpp_3m_sde_gpu",
            "ddpm",
            "lcm",
            "ipndm",
            "ipndm_v",
            "deis",
            "cfgpp_ud10_ab",
            "res_multistep",
            "res_multistep_cfg_pp",
            "res_multistep_ancestral",
            "res_multistep_ancestral_cfg_pp",
            "gradient_estimation",
            "gradient_estimation_cfg_pp",
            "er_sde",
            "seeds_2",
            "seeds_3",
            "sa_solver",
            "sa_solver_pece",
            "ddim",
            "uni_pc",
            "uni_pc_bh2",
            "supreme",
            "dpmpp_3m_sde_dynamic_eta",
            "euler_ancestral_dancing",
            "lcm_custom_noise",
            "ttm",
            "clyb_4m_sde_momentumized",
            "dpmpp_dualsde_momentumized",
            "res_momentumized"
